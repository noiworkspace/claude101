# Environment Variables Example
# Copy this file to .env and fill in your actual values

# Database Configuration
# PostgreSQL - Member data
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres123
POSTGRES_DB=claude101_db
DATABASE_URL=postgresql://postgres:postgres123@localhost:5432/claude101_db

# Redis - Sessions and caching
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=redis123
REDIS_URL=redis://:redis123@localhost:6379

# MongoDB - Logs and analytics
MONGODB_HOST=localhost
MONGODB_PORT=27017
MONGODB_USER=mongo
MONGODB_PASSWORD=mongo123
MONGODB_DB=claude101_logs
MONGODB_URL=mongodb://mongo:mongo123@localhost:27017/claude101_logs?authSource=admin

# Application
NODE_ENV=development
NEXT_PUBLIC_API_URL=http://localhost:3000

# Security
JWT_SECRET=your-super-secret-jwt-key-change-in-production
SESSION_SECRET=your-session-secret-change-in-production
BCRYPT_ROUNDS=10

# Claude API Key (if you want to use Claude API in the future)
# CLAUDE_API_KEY=your-api-key-here
